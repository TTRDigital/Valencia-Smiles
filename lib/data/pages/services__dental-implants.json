     {
      "_key": "beb87ad",
      "cls": "elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget-text-editor",
      "_type": "text",
      "html": "<p>We make the dental implant process clear and comfortable from the first consultation to the final restoration. Your timeline may vary depending on your oral health, bone support, healing needs, and whether extractions or bone grafting are required.</p>"
     },
     {
      "_key": "b9ce3ac",
      "cls": "elementor-hidden-mobile elementor-widget-image",
      "_type": "image",
      "img": {
       "src": "/images/uploads/2025/07/line-background.svg",
