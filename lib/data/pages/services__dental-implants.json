           "width": 58,
           "height": 134,
           "cls": "attachment-full size-full wp-image-1024",
           "alt": ""
          },
          "titleTag": "p",
          "title": "Consultation &  Personalized Planning",
          "desc": "We begin with an exam, digital imaging, and a review of your health, bite, missing teeth, and smile goals. If needed, Dr. Moezzi may recommend preparatory care such as extractions, periodontal treatment, or bone grafting."
         }
        ]
       },
       {
        "_type": "box",
        "_key": "c306ace",
        "cls": "e-con-full e-flex e-con e-child",
        "children": [
         {
          "_key": "e09d244",
          "cls": "elementor-position-top elementor-widget-image-box",
          "_type": "imageBox",
          "img": {
           "src": "/images/uploads/2025/07/2-image.png",
           "width": 102,
           "height": 133,
           "cls": "attachment-full size-full wp-image-1025",
           "alt": ""
          },
          "titleTag": "p",
          "title": "Implant Placement",
          "desc": "The implant is placed in the jawbone using a carefully planned approach. Local anesthesia is used, and sedation options may be available. Over time, the implant heals and bonds with the bone to create a stable foundation."
         }
        ]
       },
       {
        "_type": "box",
        "_key": "b94b433",
        "cls": "e-con-full e-flex e-con e-child",
        "children": [
         {
          "_key": "5ed42c0",
          "cls": "elementor-position-top elementor-widget-image-box",
          "_type": "imageBox",
          "img": {
           "src": "/images/uploads/2025/07/3-image.png",
           "width": 104,
           "height": 133,
           "cls": "attachment-full size-full wp-image-1026",
           "alt": ""
          },
          "titleTag": "p",
          "title": "Restoration & Smile Reveal",
          "desc": "After healing, a custom crown, bridge, or denture is attached to restore your smile. We check your bite, comfort, and healing so your implant restoration feels natural and functions properly."
         }
        ]
       }
      ]
     }
    ]
