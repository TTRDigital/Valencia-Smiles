            "icon": {
             "svg": "e-fas-circle"
            }
           },
           {
            "_key": "i1",
            "text": "You want a fixed replacement instead of a removable denture",
            "icon": {
             "svg": "e-fas-circle"
            }
           },
           {
            "_key": "i2",
            "text": "Your gums are healthy or can be treated before implant placement",
            "icon": {
             "svg": "e-fas-circle"
            }
           },
           {
            "_key": "i3",
            "text": "You have enough jawbone support, or you are open to bone grafting if needed",
            "icon": {
             "svg": "e-fas-circle"
            }
           },
           {
            "_key": "i4",
            "text": "You want to improve chewing, speaking, and smile confidence",
            "icon": {
             "svg": "e-fas-circle"
            }
